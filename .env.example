# Financial Modeling Prep (Ultimate plan) API key.
# Get yours at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# Path to the embedded DuckDB database file (created on first run).
DUCKDB_PATH=./data/scanner.duckdb

# Timezone used for scheduling the daily job (US market close).
TZ=America/New_York

# Conservative FMP request budget (Ultimate allows ~3000/min). Tune as needed.
FMP_RATE_LIMIT_PER_MIN=300

# Base URL for the public SvelteKit app to reach its own API (used by the worker if needed).
PUBLIC_APP_URL=http://localhost:5173
